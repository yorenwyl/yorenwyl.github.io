#include <ctype.h>             // Character tekshiruvlari uchun standart kutubxona

/* Operator belgisi ekanligini tekshirish
 * Parametr: c - tekshiriladigan belgi
 * Qaytaradi: 1 agar operator bo'lsa, 0 aks holda */
int is_operator(char c) { 
    return c == '+' || c == '-' || c == '*' || c == '/'; 
}

/* Raqam belgisi ekanligini tekshirish
 * Parametr: c - tekshiriladigan belgi
 * Qaytaradi: 1 agar raqam bo'lsa, 0 aks holda */
int my_isdigit(char c) { 
    return (c >= '0' && c <= '9'); 
}

/* Harf belgisi ekanligini tekshirish
 * Parametr: c - tekshiriladigan belgi
 * Qaytaradi: 1 agar harf bo'lsa, 0 aks holda */
int my_isalpha(char c) { 
    return ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); 
}

/* Ifodadagi sonlarni qayta ishlash
 * Parametrlar:
 *   expression - kiruvchi ifoda stringi
 *   tokens - tokenlar massivi (reference orqali)
 *   num_tokens - tokenlar soni (reference orqali)
 *   i - joriy indeks (reference orqali o'zgartiriladi) */
void processing_numbers(const char *expression, Token **tokens, int *num_tokens, int *i) {
    int j = 0;                // Raqam stringi uchun indeks
    char num[50] = {'\0'};    // Raqam stringi uchun buffer
    
    // Raqam yoki nuqta bo'lguncha o'qish
    while (my_isdigit(expression[*i]) || expression[*i] == '.') {
        num[j++] = expression[*i];  // Belgini qo'shish
        *i = *i + 1;                // Indeksni oshirish
    }
    
    // Yangi tokenni qo'shish
    (*num_tokens)++;
    *tokens = (Token *)realloc(*tokens, sizeof(Token) * (*num_tokens));
    (*tokens)[(*num_tokens) - 1].type = TOKEN_NUMBER;
    strcpy((*tokens)[(*num_tokens) - 1].value, num);
}

/* Unary minusni qayta ishlash
 * Parametrlar:
 *   tokens - tokenlar massivi (reference orqali)
 *   num_tokens - tokenlar soni (reference orqali)
 *   i - joriy indeks (reference orqali o'zgartiriladi) */
void unary_minus(Token **tokens, int *num_tokens, int *i) {
    // Yangi tokenni qo'shish
    (*num_tokens)++;
    *tokens = (Token *)realloc(*tokens, sizeof(Token) * (*num_tokens));
    (*tokens)[(*num_tokens) - 1].type = TOKEN_OPERATOR;
    (*tokens)[(*num_tokens) - 1].value[0] = '#';  // Unary minus belgisi
    (*tokens)[(*num_tokens) - 1].value[1] = '\0';
    *i = *i + 1;  // Indeksni oshirish
}

/* Operatorlarni qayta ishlash
 * Parametrlar:
 *   expression - kiruvchi ifoda stringi
 *   tokens - tokenlar massivi (reference orqali)
 *   num_tokens - tokenlar soni (reference orqali)
 *   i - joriy indeks (reference orqali o'zgartiriladi) */
void processing_operators(const char *expression, Token **tokens, int *num_tokens, int *i) {
    // Yangi tokenni qo'shish
    (*num_tokens)++;
    *tokens = (Token *)realloc(*tokens, sizeof(Token) * (*num_tokens));
    (*tokens)[(*num_tokens) - 1].type = TOKEN_OPERATOR;
    (*tokens)[(*num_tokens) - 1].value[0] = expression[*i];  // Operator belgisi
    (*tokens)[(*num_tokens) - 1].value[1] = '\0';
    *i = *i + 1;  // Indeksni oshirish
}

/* Chap qavsni qayta ishlash
 * Parametrlar:
 *   tokens - tokenlar massivi (reference orqali)
 *   num_tokens - tokenlar soni (reference orqali)
 *   i - joriy indeks (reference orqali o'zgartiriladi) */
void processing_the_left_bracket(Token **tokens, int *num_tokens, int *i) {
    // Yangi tokenni qo'shish
    (*num_tokens)++;
    *tokens = (Token *)realloc(*tokens, sizeof(Token) * (*num_tokens));
    (*tokens)[(*num_tokens) - 1].type = TOKEN_LEFT_PAREN;
    (*tokens)[(*num_tokens) - 1].value[0] = '(';  // Chap qavs belgisi
    (*tokens)[(*num_tokens) - 1].value[1] = '\0';
    *i = *i + 1;  // Indeksni oshirish
}

/* O'ng qavsni qayta ishlash
 * Parametrlar:
 *   tokens - tokenlar massivi (reference orqali)
 *   num_tokens - tokenlar soni (reference orqali)
 *   i - joriy indeks (reference orqali o'zgartiriladi) */
void processing_the_right_bracket(Token **tokens, int *num_tokens, int *i) {
    // Yangi tokenni qo'shish
    (*num_tokens)++;
    *tokens = (Token *)realloc(*tokens, sizeof(Token) * (*num_tokens));
    (*tokens)[(*num_tokens) - 1].type = TOKEN_RIGHT_PAREN;
    (*tokens)[(*num_tokens) - 1].value[0] = ')';  // O'ng qavs belgisi
    (*tokens)[(*num_tokens) - 1].value[1] = '\0';
    *i = *i + 1;  // Indeksni oshirish
}

/* Funksiyalar va o'zgaruvchilarni qayta ishlash
 * Parametrlar:
 *   expression - kiruvchi ifoda stringi
 *   tokens - tokenlar massivi (reference orqali)
 *   num_tokens - tokenlar soni (reference orqali)
 *   i - joriy indeks (reference orqali o'zgartiriladi) */
void processing_functions_or_variables(const char *expression, Token **tokens, int *num_tokens, int *i) {
    int j = 0
    // Identifikator stringi uchun indeks
    char identifier[50] = {'\0'};  // Identifikator stringi uchun buffer
    
    // Harf bo'lguncha o'qish
    while (my_isalpha(expression[*i])) {
        identifier[j++] = expression[*i];  // Belgini qo'shish
        *i = *i + 1;                      // Indeksni oshirish
    }
    
    // Yangi tokenni qo'shish
    (*num_tokens)++;
    *tokens = (Token *)realloc(*tokens, sizeof(Token) * (*num_tokens));
    
    // Agar identifikator matematik funksiya bo'lsa
    if (strcmp(identifier, "sin") == 0 || strcmp(identifier, "cos") == 0 || 
        strcmp(identifier, "tan") == 0 || strcmp(identifier, "ctg") == 0 || 
        strcmp(identifier, "sqrt") == 0 || strcmp(identifier, "ln") == 0) {
        (*tokens)[(*num_tokens) - 1].type = TOKEN_FUNCTION;
    } else {
        // Aks holda o'zgaruvchi deb hisoblash
        (*tokens)[(*num_tokens) - 1].type = TOKEN_VARIABLE;
    }
    
    // Identifikator qiymatini nusxalash
    strcpy((*tokens)[(*num_tokens) - 1].value, identifier);
}

/* Ifodani tokenlarga ajratish funksiyasi
 * Parametrlar:
 *   expression - kiruvchi ifoda stringi
 *   tokens - tokenlar massivi (reference orqali)
 *   num_tokens - tokenlar soni (reference orqali) */
void parse_expression(const char *expression, Token **tokens, int *num_tokens) {
    *num_tokens = 0;    // Tokenlar sonini nolga tenglash
    *tokens = NULL;     // Tokenlar massivini NULL ga tenglash
    int i = 0;          // Ifoda indeksi
    
    // Ifoda oxirigacha ishlov berish
    while (expression[i] != '\0') {
        // Bo'sh joylarni o'tkazib yuborish
        if (expression[i] == ' ') {
            i++;
            continue;
        }
        
        // Raqam bo'lsa
        if (my_isdigit(expression[i])) {
            processing_numbers(expression, tokens, num_tokens, &i);
        } 
        // Unary minus bo'lsa
        else if (expression[i] == '-' && expression[i - 1] != ')' &&
                 (i == 0 || !my_isdigit(expression[i - 1]))) {
            unary_minus(tokens, num_tokens, &i);
        } 
        // Operator bo'lsa
        else if (is_operator(expression[i])) {
            processing_operators(expression, tokens, num_tokens, &i);
        } 
        // Chap qavs bo'lsa
        else if (expression[i] == '(') {
            processing_the_left_bracket(tokens, num_tokens, &i);
        } 
        // O'ng qavs bo'lsa
        else if (expression[i] == ')') {
            processing_the_right_bracket(tokens, num_tokens, &i);
        } 
        // Harf bo'lsa (funksiya yoki o'zgaruvchi)
        else if (my_isalpha(expression[i])) {
            processing_functions_or_variables(expression, tokens, num_tokens, &i);
        } 
        // Boshqa belgilar
        else {
            i++;  // O'tkazib yuborish
        }
    }
}
