#include "evaluate_rpn.h"  // evaluate_rpn.h header fayli - o'z yaratilgan kutubxona
#include <math.h>          // Matematik funksiyalar uchun standart kutubxona (sin, cos, sqrt)
#include <stdio.h>         // Kirish/chiqish funksiyalari uchun standart kutubxona
#include <stdlib.h>        // Xotira boshqaruvi va konvertatsiya funksiyalari uchun standart kutubxona
#include <string.h>        // String operatsiyalari uchun standart kutubxona

/* double sonni stringga aylantirish funksiyasi
 * Parametr: num - aylantiriladigan double son
 * Qaytaradi: heapda yaratilgan string ko'rsatkichi
 * Xotirani tozalash: chaqiruvchi tomonidan free() qilinishi kerak */
char *ftos(double num) {
    char *str = (char *)malloc(20);  // Heapda 20 bayt joy ajratish (stdlib.h)
    snprintf(str, 20, "%lf", num);   // Sonni stringga formatlash (stdio.h)
    return str;
}

/* O'zgaruvchi tokenlari bilan ishlash funksiyasi (x qiymatini hisoblash)
 * Parametrlar:
 *   current_token - ishlayotgan token (token.h)
 *   operand_stack - operandlar steki (stack.h)
 *   x - o'zgaruvchining qiymati */
void function_variable(const Token *current_token, Stack *operand_stack, double x) {
    if (current_token->value[0] == '-') {  // Agar manfiy belgi bo'lsa
        char *ccc = ftos(-x);              // -x qiymatini stringga aylantirish
        stack_push(operand_stack, ccc);    // Stackga qo'shish (stack.h)
        free(ccc);                         // Vaqtinchalik xotirani bo'shatish
    } else {
        char *ccc = ftos(x);               // Musbat x qiymatini stringga aylantirish
        stack_push(operand_stack, ccc);    // Stackga qo'shish
        free(ccc);                         // Vaqtinchalik xotirani bo'shatish
    }
}

/* Operatorlar bilan ishlash funksiyasi (+, -, *, /)
 * Parametrlar:
 *   current_token - ishlayotgan operator tokeni
 *   operand_stack - operandlar steki */
void function_operator(const Token *current_token, Stack *operand_stack) {
    // Stackdan 2-operandni olish va uni double ga aylantirish (stdlib.h)
    double operand2 = atof(stack_top(operand_stack));
    char *o1 = stack_pop(operand_stack);  // Stackdan chiqarib olish
    free(o1);                             // Xotirani bo'shatish
    
    // Stackdan 1-operandni olish va uni double ga aylantirish
    double operand1 = atof(stack_top(operand_stack));
    char *o2 = stack_pop(operand_stack);  // Stackdan chiqarib olish
    free(o2);                             // Xotirani bo'shatish
    
    // Operator turini tekshirish va mos amalni bajaring
    if (strcmp(current_token->value, "+") == 0) {  // Qo'shish (string.h)
        char *ccc = ftos(operand1 + operand2);     // Natijani stringga aylantirish
        stack_push(operand_stack, ccc);            // Stackga natijani qo'shish
        free(ccc);                                 // Vaqtinchalik xotirani bo'shatish
    } 
    else if (strcmp(current_token->value, "-") == 0) {  // Ayirish
        char *ccc = ftos(operand1 - operand2);
        stack_push(operand_stack, ccc);
        free(ccc);
    } 
    else if (strcmp(current_token->value, "*") == 0) {  // Ko'paytirish
        char *ccc = ftos(operand1 * operand2);
        stack_push(operand_stack, ccc);
        free(ccc);
    } 
    else if (strcmp(current_token->value, "/") == 0) {  // Bo'lish
        char *ccc = ftos(operand1 / operand2);
        stack_push(operand_stack, ccc);
        free(ccc);
    }
}

/* Matematik funksiyalar bilan ishlash (sin, cos, tan, ln, etc.)
 * Parametrlar:
 *   current_token - ishlayotgan funksiya tokeni
 *   operand_stack - operandlar steki */
void function_function(const Token *current_token, Stack *operand_stack) {
    // Stackdan operandni olish va uni double ga aylantirish
    double operand = atof(stack_top(operand_stack));
    char *c = stack_pop(operand_stack);  // Stackdan chiqarib olish
    free(c);                             // Xotirani bo'shatish
    
    // Funksiya turini tekshirish va mos matematik hisobni bajaring
    if (strcmp(current_token->value, "sin") == 0) {  // sinus (math.h)
        char *ccc = ftos(sin(operand));
        stack_push(operand_stack, ccc);
        free(ccc);
    } 
    else if (strcmp(current_token->value, "cos") == 0) {  // kosinus
        char *ccc = ftos(cos(operand));
        stack_push(operand_stack, ccc);
        free(ccc);
    } 
    else if (strcmp(current_token->value, "tan") == 0) {  // tangens
        char *ccc = ftos(tan(operand));
        stack_push(operand_stack, ccc);
        free(ccc);
    } 
    else if (strcmp(current_token->value, "ctg") == 0) {  // kotangens
        char *ccc = ftos(1.0 / tan(operand));
        stack_push(operand_stack, ccc);
        free(ccc);
    } 
    else if (strcmp(current_token->value, "sqrt") == 0) {  // ildiz
        char *ccc = ftos(sqrt(operand));
        stack_push(operand_stack, ccc);
        free(ccc);
    } 
    else if (strcmp(current_token->value, "ln") == 0) {  // natural logarifm
        char *ccc = ftos(log(operand));
        stack_push(operand_stack, ccc);
        free(ccc);
    }
}

/* Asosiy RPN baholash funksiyasi
 * Parametrlar:
 *   rpn_tokens - RPN shaklidagi tokenlar massivi
 *   num_rpn_tokens - tokenlar soni
 *   x - o'zgaruvchining qiymati
 * Qaytaradi: hisoblangan natija */
double evaluate_rpn(const Token *rpn_tokens, int num_rpn_tokens, double x) {
    Stack operand_stack;                       // Operandlar uchun stack
    stack_init(&operand_stack, num_rpn_tokens); // Stackni ishga tushirish
    
    // Har bir token uchun ishlov berish
    for (int i = 0; i < num_rpn_tokens; i++) {
        const Token *current_token = &rpn_tokens[i];
        
        if (current_token->type == TOKEN_NUMBER) {  // Agar token son bo'lsa
            stack_push(&operand_stack, current_token->value);  // Stackga qo'shish
        } 
        else if (current_token->type == TOKEN_VARIABLE) {  // O'zgaruvchi bo'lsa
            function_variable(current_token, &operand_stack, x);
        } 
        else if (current_token->type == TOKEN_OPERATOR) {  // Operator bo'lsa
            function_operator(current_token, &operand_stack);
        } 
        else if (current_token->type == TOKEN_FUNCTION) {  // Funksiya bo'lsa
            function_function(current_token, &operand_stack);
        }
    }
    
    // Yakuniy natijani olish
    double result = atof(stack_top(&operand_stack));  // Stackdagi oxirgi element
    char *c = stack_pop(&operand_stack);             // Stackdan chiqarish
    free(c);                                         // Xotirani bo'shatish
    
    stack_free(&operand_stack);  // Stack xotirasini tozalash
    return result;               // Natijani qaytarish
}

/* RPN funksiyasini baholash uchun wrapper funksiya
 * Parametrlar: evaluate_rpn bilan bir xil
 * Qaytaradi: evaluate_rpn natijasi */
double evaluate_rpn_function(const Token *rpn_tokens, int num_rpn_tokens, double x) {
    return evaluate_rpn(rpn_tokens, num_rpn_tokens, x);
}
