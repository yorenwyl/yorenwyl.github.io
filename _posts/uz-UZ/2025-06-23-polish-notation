```c
#include "stack.h"  // O'z header fayli
#include <stdlib.h> // Xotira boshqaruvi uchun standart kutubxona
#include <string.h> // String operatsiyalari uchun standart kutubxona

/* Stackni ishga tushirish (initialization)
 * Parametrlar:
 *   stack - ishga tushiriladigan stack
 *   size - stack uchun ajratiladigan maksimal hajm */
void stack_init(Stack *stack, int size) {
    stack->data = (char **)malloc(sizeof(char *) * size);  // Stringlar massivi uchun xotira
    stack->size = size;  // Stack maksimal hajmi
    stack->top = -1;     // Boshlang'ich indeks (stack bo'sh)
}

/* Stack bo'sh ekanligini tekshirish
 * Parametr: stack - tekshiriladigan stack
 * Qaytaradi: 1 agar stack bo'sh bo'lsa, 0 aks holda */
int stack_empty(const Stack *stack) { 
    return stack->top == -1; 
}

/* Stackga element qo'shish (push)
 * Parametrlar:
 *   stack - element qo'shiladigan stack
 *   value - qo'shiladigan string qiymati */
void stack_push(Stack *stack, const char *value) {
    // Agar stack to'lib qolmagan bo'lsa
    if (stack->top < stack->size - 1) {
        stack->top++;  // Yuqori indeksni oshirish
        
        // String uchun xotira ajratish (+1 null terminator uchun)
        stack->data[stack->top] = (char *)malloc(sizeof(char) * (strlen(value) + 1));
        
        // String qiymatini nusxalash
        strcpy(stack->data[stack->top], value);
    }
}

/* Stackdan element olish (pop)
 * Parametr: stack - element olinadigan stack
 * Qaytaradi: olingan string ko'rsatkichi (yoki NULL agar stack bo'sh bo'lsa)
 * Eslatma: chaqiruvchi tomonidan free() qilinishi kerak */
char *stack_pop(Stack *stack) {
    char *value = NULL;  // Boshlang'ich qiymat
    
    // Agar stack bo'sh bo'lmasa
    if (!stack_empty(stack)) {
        value = stack->data[stack->top];  // Yuqori elementni olish
        stack->top--;                     // Yuqori indeksni kamaytirish
    }
    
    return value;  // Elementni qaytarish (yoki NULL)
}

/* Stackning yuqori elementini ko'rish (top)
 * Parametr: stack - ko'riladigan stack
 * Qaytaradi: yuqori element string ko'rsatkichi (yoki NULL agar stack bo'sh bo'lsa)
 * Eslatma: NOT free() qilinishi kerak - faqat ko'rish uchun */
char *stack_top(const Stack *stack) {
    char *value = NULL;  // Boshlang'ich qiymat
    
    // Agar stack bo'sh bo'lmasa
    if (!stack_empty(stack)) {
        value = stack->data[stack->top];  // Yuqori elementni ko'rsatish
    }
    
    return value;  // Elementni qaytarish (yoki NULL)
}

/* Stack xotirasini tozalash (free)
 * Parametr: stack - xotirasi tozalanadigan stack */
void stack_free(Stack *stack) {
    // Har bir element uchun xotirani bo'shatish
    for (int i = 0; i <= stack->top; i++) {
        free(stack->data[i]);  // String xotirasini bo'shatish
    }
    
    free(stack->data);  // Stringlar massivi xotirasini bo'shatish
}
