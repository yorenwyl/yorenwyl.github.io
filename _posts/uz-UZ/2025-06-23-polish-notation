/* Grafik matritsasini tozalash (barcha elementlarni nuqtalar bilan to'ldirish)
 * Parametr: matrix - ishlov beriladigan grafik matritsasi */
void fill_graph(int matrix[HEIGHT][WIDTH]) {
    for (int i = 0; i < HEIGHT; i++) {
        for (int j = 0; j < WIDTH; j++) {
            matrix[i][j] = void_sym;  // Har bir katakni nuqta bilan to'ldirish
        }
    }
}

/* Grafikni hisoblash va matritsaga yozish
 * Parametrlar:
 *   matrix - grafik matritsasi
 *   rpn_tokens - RPN shaklidagi tokenlar massivi
 *   num_rpn_tokens - tokenlar soni */
void create_graphic(int matrix[HEIGHT][WIDTH], const Token *rpn_tokens, int num_rpn_tokens) {
    for (int i = 0; i < WIDTH; i++) {
        // X qiymatini hisoblash (0 dan 4π gacha)
        double x = (i * 4.0 * M_PI) / (WIDTH - 1);
        
        // Funksiya qiymatini hisoblash
        double res = evaluate_rpn_function(rpn_tokens, num_rpn_tokens, x);
        
        // Y qiymatini matritsa indeksiga aylantirish (-1..1 dan 0..HEIGHT-1 gacha)
        int y = round((res + 1) * (HEIGHT - 1) / 2);
        
        // Agar y matritsa chegaralarida bo'lsa, yulduzcha qo'yish
        if (y >= 0 && y < HEIGHT) {
            matrix[y][i] = sym;
        }
    }
}

/* Grafikni terminalda chiqarish
 * Parametr: matrix - chiqariladigan grafik matritsasi */
void print_graph(const int matrix[HEIGHT][WIDTH]) {
    for (int i = 0; i < HEIGHT; i++) {
        for (int j = 0; j < WIDTH; j++) {
            putchar(matrix[i][j]);  // Har bir belgini chiqarish (stdio.h)
        }
        putchar('\n');  // Yangi qator
    }
}
