#include "infix_to_rpn.h"  // O'z header fayli
#include <string.h>        // String operatsiyalari uchun standart kutubxona

/* Operatorlarning ustuvorligini aniqlash funksiyasi
 * Parametr: operator - tekshiriladigan operator stringi
 * Qaytaradi: operatorning ustuvorlik darajasi */
int precedence(const char *operator) {
    int priority = 0;  // Boshlang'ich ustuvorlik
    
    // Past ustuvorlik operatorlari
    if (strcmp(operator, "+") == 0 || strcmp(operator, "-") == 0) {
        priority = 1;
    } 
    // Yuqori ustuvorlik operatorlari
    else if (strcmp(operator, "*") == 0 || strcmp(operator, "/") == 0) {
        priority = 2;
    } 
    // Funksiyalar (ham yuqori ustuvorlikda)
    else if (strcmp(operator, "sin") == 0 || strcmp(operator, "cos") == 0 || 
             strcmp(operator, "tan") == 0 || strcmp(operator, "ctg") == 0 || 
             strcmp(operator, "sqrt") == 0 || strcmp(operator, "ln") == 0) {
        priority = 2;
    }
    return priority;
}

/* Son yoki o'zgaruvchi tokenlarini RPN ro'yxatiga qo'shish
 * Parametrlar:
 *   rpn_tokens - RPN tokenlari massivi
 *   num_rpn_tokens - RPN tokenlari soni
 *   current_token - qo'shiladigan token */
void number_or_variable(Token **rpn_tokens, int *num_rpn_tokens, const Token *current_token) {
    (*num_rpn_tokens)++;  // Tokenlar sonini oshirish
    // Xotirani qayta ajratish (stdlib.h)
    *rpn_tokens = (Token *)realloc(*rpn_tokens, sizeof(Token) * (*num_rpn_tokens));
    // Yangi tokenga qiymatlarini nusxalash
    (*rpn_tokens)[(*num_rpn_tokens) - 1] = *current_token;
}

/* Unary minus bilan ishlash (masalan, -5 yoki -x)
 * Parametrlar:
 *   infix_tokens - infix tokenlar massivi
 *   rpn_tokens - RPN tokenlari massivi
 *   num_rpn_tokens - RPN tokenlari soni
 *   i - joriy indeks (reference orqali o'zgartiriladi) */
void unary_minus_2(const Token *infix_tokens, Token **rpn_tokens, int *num_rpn_tokens, int *i) {
    const Token *next_token = &infix_tokens[*i + 1];  // Keyingi tokenni olish
    
    // Unary minusning turli holatlari
    if (next_token->type == TOKEN_LEFT_PAREN && infix_tokens[*i + 2].value[0] == '#') {
        *i = *i + 2;  // Indeksni oshirish
    } 
    else if (next_token->type == TOKEN_LEFT_PAREN &&
             (infix_tokens[*i + 2].type == TOKEN_NUMBER || infix_tokens[*i + 2].type == TOKEN_VARIABLE)) {
        // Manfiy son yoki o'zgaruvchi yaratish
        char new_value[50];
        new_value[0] = '-';  // Manfiy belgi
        
        // Qiymatni nusxalash
        for (int j = 1; infix_tokens[*i + 2].value[j - 1] != '\0'; j++) {
            new_value[j] = infix_tokens[*i + 2].value[j - 1];
            if (infix_tokens[*i + 2].value[j - 1] == '\0') {
                new_value[j + 1] = '\0';
            }
        }
        
        // Yangi tokenni qo'shish
        (*num_rpn_tokens)++;
        *rpn_tokens = (Token *)realloc(*rpn_tokens, sizeof(Token) * (*num_rpn_tokens));
        (*rpn_tokens)[(*num_rpn_tokens) - 1].type = infix_tokens[*i + 2].type;
        strcpy((*rpn_tokens)[(*num_rpn_tokens) - 1].value, new_value);
        
        *i = *i + 2;  // Indeksni oshirish
    } 
    else if (next_token->value[0] == '#') {
        *i = *i + 1;  // Indeksni oshirish
    }
    
    // Agar keyingi token son yoki o'zgaruvchi bo'lsa
    if (next_token->type == TOKEN_NUMBER || next_token->type == TOKEN_VARIABLE) {
        char new_value[50];
        new_value[0] = '-';  // Manfiy belgi
        
        // Qiymatni nusxalash
        for (int j = 1; next_token->value[j - 1] != '\0'; j++) {
            new_value[j] = next_token->value[j - 1];
            if (next_token->value[j - 1] == '\0') {
                new_value[j + 1] = '\0';
            }
        }
        
        // Yangi tokenni qo'shish
        (*num_rpn_tokens)++;
        *rpn_tokens = (Token *)realloc(*rpn_tokens, sizeof(Token) * (*num_rpn_tokens));
        (*rpn_tokens)[(*num_rpn_tokens) - 1].type = next_token->type;
        strcpy((*rpn_tokens)[(*num_rpn_tokens) - 1].value, new_value);
        
        *i = *i + 1;  // Indeksni oshirish
    }
}

/* Unary bo'lmagan operatorlar bilan ishlash
 * Parametrlar:
 *   operator_stack - operatorlar steki
 *   rpn_tokens - RPN tokenlari massivi
 *   num_rpn_tokens - RPN tokenlari soni
 *   current_token - joriy operator tokeni */
void non_unary_minus(Stack *operator_stack, Token **rpn_tokens, int *num_rpn_tokens,
                     const Token *current_token) {
    // Stackda ustuvorligi yuqori operatorlarni chiqarish
    while (!stack_empty(operator_stack) &&
           precedence(stack_top(operator_stack)) >= precedence(current_token->value) &&
           strcmp(stack_top(operator_stack), "(") != 0) {
        char *operator = stack_pop(operator_stack);  // Stackdan operatorni olish
        
        // RPN ro'yxatiga qo'shish
        (*num_rpn_tokens)++;
        *rpn_tokens = (Token *)realloc(*rpn_tokens, sizeof(Token) * (*num_rpn_tokens));
        (*rpn_tokens)[(*num_rpn_tokens) - 1].type = TOKEN_OPERATOR;
        strcpy((*rpn_tokens)[(*num_rpn_tokens) - 1].value, operator);
        
        free(operator);  // Xotirani bo'shatish
    }
    
    // Joriy operatorni stackga qo'shish
    stack_push(operator_stack, current_token->value);
}

/* O'ng qavs bilan ishlash (infix ifodada ")" belgisi)
 * Parametrlar:
 *   operator_stack - operatorlar steki
 *   rpn_tokens - RPN tokenlari massivi
 *   num_rpn_tokens - RPN tokenlari soni */
void right_bracket(Stack *operator_stack, Token **rpn_tokens, int *num_rpn_tokens) {
    // Chap qavs topilguncha stackdan chiqarish
    while (!stack_empty(operator_stack) && strcmp(stack_top(operator_stack), "(") != 0) {
        char *operator = stack_pop(operator_stack);  // Stackdan operatorni olish
        
        // RPN ro'yxatiga qo'shish
        (*num_rpn_tokens)++;
        *rpn_tokens = (Token *)realloc(*rpn_tokens, sizeof(Token) * (*num_rpn_tokens));
        (*rpn_tokens)[(*num_rpn_tokens) - 1].type = TOKEN_OPERATOR;
        strcpy((*rpn_tokens)[(*num_rpn_tokens) - 1].value, operator);
        
        free(operator);  // Xotirani bo'shatish
    }
    
    // Chap qavsni stackdan olib tashlash
    char *operator = stack_pop(operator_stack);
    free(operator);
    
    // Agar stackda funksiya qolgan bo'lsa (masalan, sin( ))
    if (!stack_empty(operator_stack) && stack_top(operator_stack)[0] != '(') {
        if (strcmp(stack_top(operator_stack), "sin") == 0 || 
            strcmp(stack_top(operator_stack), "cos") == 0 ||
            strcmp(stack_top(operator_stack), "tan") == 0 || 
            strcmp(stack_top(operator_stack), "ctg") == 0 ||
            strcmp(stack_top(operator_stack), "sqrt") == 0 || 
            strcmp(stack_top(operator_stack), "ln") == 0) {
            char *function = stack_pop(operator_stack);  // Funksiyani stackdan olish
            
            // RPN ro'yxatiga qo'shish
            (*num_rpn_tokens)++;
            *rpn_tokens = (Token *)realloc(*rpn_tokens, sizeof(Token) * (*num_rpn_tokens));
            (*rpn_tokens)[(*num_rpn_tokens) - 1].type = TOKEN_FUNCTION;
            strcpy((*rpn_tokens)[(*num_rpn_tokens) - 1].value, function);
            
            free(function);  // Xotirani bo'shatish
        }
    }
}

/* Infix ifodani RPN ga o'tkazish (Shunting-yard algoritmi)
 * Parametrlar:
 *   infix_tokens - kiruvchi infix tokenlar massivi
 *   num_infix_tokens - infix tokenlar soni
 *   rpn_tokens - chiqadigan RPN tokenlari massivi (reference orqali)
 *   num_rpn_tokens - chiqadigan RPN tokenlari soni (reference orqali) */
void infix_to_rpn(const Token *infix_tokens, int num_infix_tokens, Token **rpn_tokens, int *num_rpn_tokens) {
    *num_rpn_tokens = 0;    // Chiqish tokenlari sonini nolga tenglash
    *rpn_tokens = NULL;     // Chiqish massivini NULL ga tenglash
    Stack operator_stack;    // Operatorlar uchun stack
    stack_init(&operator_stack, num_infix_tokens);  // Stackni ishga tushirish
    
    // Har bir infix token uchun ishlov berish
    for (int i = 0; i < num_infix_tokens; i++) {
        const Token *current_token = &infix_tokens[i];
        
        if (current_token->type == TOKEN_NUMBER || current_token->type == TOKEN_VARIABLE) {
            // Agar token son yoki o'zgaruvchi bo'lsa, to'g'ridan-to'g'ri RPN ga qo'shish
            number_or_variable(rpn_tokens, num_rpn_tokens, current_token);
        } 
        else if (current_token->type == TOKEN_OPERATOR) {
            if (current_token->value[0] == '#') {
                // Unary minus bilan ishlash
                unary_minus_2(infix_tokens, rpn_tokens, num_rpn_tokens, &i);
            } else {
                // Oddiy operatorlar bilan ishlash
                non_unary_minus(&operator_stack, rpn_tokens, num_rpn_tokens, current_token);
            }
        } 
        else if (current_token->type == TOKEN_FUNCTION) {
            // Funksiyalarni stackga qo'shish
            stack_push(&operator_stack, current_token->value);
        } 
        else if (current_token->type == TOKEN_LEFT_PAREN) {
            // Chap qavslarni stackga qo'shish
            stack_push(&operator_stack, current_token->value);
        } 
        else if (current_token->type == TOKEN_RIGHT_PAREN) {
            // O'ng qavslar bilan ishlash
            right_bracket(&operator_stack, rpn_tokens, num_rpn_tokens);
        }
    }
    
    // Agar stackda operatorlar qolgan bo'lsa, ularni RPN ga qo'shish
    while (!stack_empty(&operator_stack)) {
        char *operator = stack_pop(&operator_stack);  // Stackdan operatorni olish
        
        // RPN ro'yxatiga qo'shish
        (*num_rpn_tokens)++;
        *rpn_tokens = (Token *)realloc(*rpn_tokens, sizeof(Token) * (*num_rpn_tokens));
        (*rpn_tokens)[(*num_rpn_tokens) - 1].type = TOKEN_OPERATOR;
        strcpy((*rpn_tokens)[(*num_rpn_tokens) - 1].value, operator);
        
        free(operator);  // Xotirani bo'shatish
    }
    
    stack_free(&operator_stack);  // Stack xotirasini tozalash
}
